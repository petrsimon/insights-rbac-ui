{
  "version": 1,
  "checks": [
    {
      "source": {
        "path": "locales/translation-template.json",
        "adapter": "formatjs-json",
        "locale": "en"
      },
      "targets": []
    }
  ],
  "generated": [
    {
      "path": "locales/translation-template.json",
      "command": "npm",
      "args": ["run", "translations:extract", "--", "--out-file", "{output}"],
      "adapter": "formatjs-json",
      "locale": "en",
      "role": "source"
    }
  ],
  "tmsConfig": "i18n/phrase-tms.json",
  "catalogDirectories": [{ "path": "locales" }, { "path": "messages" }],
  "sourceLint": {
    "files": ["src/Messages.js"],
    "catalog": "locales/translation-template.json"
  }
}
