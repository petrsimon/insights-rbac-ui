{
  "version": 1,
  "tmsConfig": "i18n/phrase-tms.json",
  "checks": [],
  "generated": [
    {
      "path": "locales/translation-template.json",
      "command": "npm",
      "args": ["run", "--silent", "translations:extract", "--", "--out-file", "{output}"],
      "adapter": "formatjs-json",
      "locale": "en",
      "role": "source",
      "updateCommand": "npm run translations:extract"
    }
  ],
  "feo": [
    {
      "template": "deploy/frontend.yaml",
      "source": "deploy/locales/translation-template.json",
      "locales": {
        "fr": "deploy/locales/fr.json",
        "ja": "deploy/locales/ja.json",
        "ko": "deploy/locales/ko.json",
        "zh-CN": "deploy/locales/zh-CN.json"
      }
    }
  ],
  "catalogDirectories": [{ "path": "locales" }, { "path": "messages" }, { "path": "deploy/locales" }],
  "sourceLint": {
    "files": ["src/Messages.js"],
    "catalog": "locales/translation-template.json"
  }
}
